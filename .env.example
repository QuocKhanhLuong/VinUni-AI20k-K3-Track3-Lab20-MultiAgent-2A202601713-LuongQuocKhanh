# Required for real LLM execution
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: configure current model pricing if you want USD cost estimates.
# Token totals are reported even when these are left blank.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=

# Optional tracing provider (recommended for submission evidence)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab

# Optional alternative tracing provider configuration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional search provider; without this key the Researcher uses a labeled mock source set.
TAVILY_API_KEY=

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
